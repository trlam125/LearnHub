# Copy to .env. Values use Java .properties syntax: do not surround with quotes.
APP_PROFILE=dev
SITE_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
SEED_DEMO=true
# Fill your own credentials; first startup creates this admin if email does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# MySQL 8.4. Create database/user using docs/MYSQL_SETUP.md. Docker sets its own connection.
DB_URL=jdbc:mysql://localhost:3306/learnhub?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=learnhub
DB_PASSWORD=replace-with-a-long-random-password
PRIVATE_MEDIA_ROOT=./private-media
PAYMENT_MODE=manual
BANK_NAME=
BANK_ACCOUNT=
BANK_OWNER=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
MAIL_MODE=console
FROM_EMAIL=no-reply@example.com
SUPPORT_EMAIL=support@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DOMAIN=learn.example.com
SECURE_COOKIES=false
JOBS_ENABLED=true
